{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Evaluation",
    "type": "object",
    "required": [
        "lesson_id",
        "response_type",
        "learner_response",
        "score",
        "feedback",
        "correct",
        "next_action"
    ],
    "properties": {
        "lesson_id": {
            "type": "string"
        },
        "response_type": {
            "type": "string",
            "enum": ["code", "explanation", "choice", "short_answer"]
        },
        "learner_response": {
            "type": "string"
        },
        "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
        },
        "feedback": {
            "type": "string"
        },
        "correct": {
            "type": "boolean"
        },
        "next_action": {
            "type": "string",
            "enum": [
                "retry",
                "continue",
                "review"
            ]
        },
        "misconception": {
            "type": [
                "string",
                "null"
            ]
        }
    }
}